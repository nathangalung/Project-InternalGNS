% Invoice template, rendered via text/template.
% Compile: xelatex Invoice.tex
% Requires Plus Jakarta Sans installed system-wide.

% Mirrors the quotation layout; totals run DPP, then DPP Nilai Lain and PPN when taxed, then Total.

% Portrait like the delivery note, so all three print alike.
\documentclass[a4paper]{article}

\usepackage{fontspec}
% No contextual alternates: they swap a hyphen between digits for a minus.
\setmainfont{Plus Jakarta Sans}[
  RawFeature     = -calt,
  BoldFont       = Plus Jakarta Sans Bold,
  ItalicFont     = Plus Jakarta Sans Italic,
  BoldItalicFont = Plus Jakarta Sans Bold Italic,
]

% A4 at every length; the content starts high.
\usepackage[a4paper, includehead, headheight=12pt, headsep=6pt, top=0.8cm, bottom=1.5cm, left=1.8cm, right=1.8cm]{geometry}
