% Delivery note template, rendered via text/template.
% Compile: xelatex DeliveryNote.tex
% Mirrors PO content. No prices. Lists product, qty and a note per row.

% Portrait: two signature blocks need the height.
\documentclass[a4paper]{article}

\usepackage{fontspec}
% No contextual alternates: they swap a hyphen between digits for a minus.
\setmainfont{Plus Jakarta Sans}[
  RawFeature     = -calt,
  BoldFont       = Plus Jakarta Sans Bold,
  ItalicFont     = Plus Jakarta Sans Italic,
  BoldItalicFont = Plus Jakarta Sans Bold Italic,
]

% A4 at every length, one margin on all four sides. The running header
% and the page count print inside it.
\usepackage[a4paper, margin=0.75cm, includehead, includefoot, headheight=9.7pt, headsep=6pt, footskip=14pt]{geometry}
