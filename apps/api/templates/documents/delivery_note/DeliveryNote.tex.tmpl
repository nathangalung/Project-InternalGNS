% Whole words only; English patterns would split Indonesian names.
% m columns centre every row.
\newcolumntype{L}[1]{>{\RaggedRight\arraybackslash\DocCellSize\hyphenpenalty=10000}m{#1}}
\newcolumntype{C}[1]{>{\centering\arraybackslash\DocCellSize}m{#1}}
\renewcommand{\arraystretch}{1.2}

\fancypagestyle{firstpage}{%
