ENV=development
HTTP_ADDR=:8080
TZ=Asia/Jakarta

DATABASE_URL=postgres://gns_app:gns_app@localhost:5432/gns_quotation?sslmode=disable

JWT_SECRET=change_me_with_openssl_rand_hex_32
JWT_EXPIRY=24h

CORS_ALLOWED_ORIGINS=*

SUPERADMIN_EMAIL=admin@globalsakti.com
SUPERADMIN_NAME=Administrator
SUPERADMIN_PASSWORD=CHANGE_ME_before_deploy

# Optional second superadmin. Leave EMAIL/PASSWORD empty to skip.
SUPERADMIN2_EMAIL=
SUPERADMIN2_NAME=Administrator 2
SUPERADMIN2_PASSWORD=

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false

# Coretax (DJP) e-faktur XML export. SellerTIN: PT GLOBAL NIAGA SAKTI's
# 16-digit NPWP (no separators). SellerIDTKU: NPWP + 6-digit branch suffix
# (`000000` = pusat / headquarters).
CORETAX_SELLER_TIN=
CORETAX_SELLER_IDTKU=
