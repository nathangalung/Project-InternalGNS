{
  "name": "frontend-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.9",
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "vite",
    "generate:routes": "tsr generate",
    "build": "bun run generate:routes && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome check src",
    "format": "biome format --write src",
    "typecheck": "bun run generate:routes && tsc --noEmit -p tsconfig.json",
    "analyze": "ANALYZE=true bun run build",
    "lighthouse": "lhci autorun",
    "codegen": "openapi-typescript ../api/openapi.yaml -o src/types/openapi.gen.ts",
    "codegen:check": "bun run codegen && git diff --exit-code -- src/types/openapi.gen.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-router": "^1.169.2",
    "exceljs": "^4.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "overrides": {
    "tmp": "^0.2.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@lhci/cli": "^0.15.0",
    "@tailwindcss/vite": "^4.3.0",
    "openapi-typescript": "^7.6.1",
    "@tanstack/react-query-devtools": "^5.100.10",
    "@tanstack/react-router-devtools": "^1.166.13",
    "@tanstack/router-cli": "^1.166.43",
    "@tanstack/router-plugin": "^1.167.35",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
