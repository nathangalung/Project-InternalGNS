{
  "name": "frontend-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "vite",
    "generate:routes": "tsr generate",
    "build": "bun run generate:routes && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "lint": "biome check src e2e/*.ts e2e/support playwright.config.ts vitest.config.ts",
    "format": "biome format --write src",
    "typecheck": "bun run generate:routes && tsc --noEmit -p tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "analyze": "ANALYZE=true bun run build",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource/inter": "^5.3.0",
    "@tanstack/react-query": "^5.103.3",
    "@tanstack/react-router": "^1.170.39",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-variants": "^3.3.1"
  },
  "overrides": {
    "tmp": "^0.2.7",
    "brace-expansion": "^1.1.21"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.103.3",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-cli": "^1.167.38",
    "@tanstack/router-plugin": "^1.168.40",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "happy-dom": "^20.14.5",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
