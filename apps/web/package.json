{
  "name": "frontend-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "vite",
    "generate:routes": "tsr generate",
    "build": "bun run generate:routes && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:csp": "E2E_CSP=enforce playwright test -c playwright.csp.config.ts",
    "lint": "biome check src e2e/*.ts e2e/support playwright.config.ts playwright.csp.config.ts vitest.config.ts",
    "format": "biome format --write src",
    "typecheck": "bun run generate:routes && tsc --noEmit -p tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "analyze": "ANALYZE=true bun run build",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource/inter": "^5.3.0",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-router": "^1.170.46",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-variants": "^3.3.1"
  },
  "overrides": {
    "tmp": "^0.2.7",
    "brace-expansion": "^1.1.21"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-query-devtools": "^5.106.1",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-cli": "^1.167.46",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/bun": "^1.4.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "happy-dom": "^20.14.6",
    "rollup-plugin-visualizer": "^7.1.2",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
