{
  "ci": {
    "collect": {
      "startServerCommand": "bun run preview --port 4173 --host 127.0.0.1",
      "startServerReadyPattern": "Local:",
      "url": [
        "http://127.0.0.1:4173/login",
        "http://127.0.0.1:4173/",
        "http://127.0.0.1:4173/dashboard-financial",
        "http://127.0.0.1:4173/dashboard-operational",
        "http://127.0.0.1:4173/clients",
        "http://127.0.0.1:4173/products",
        "http://127.0.0.1:4173/vendors",
        "http://127.0.0.1:4173/users",
        "http://127.0.0.1:4173/quotations",
        "http://127.0.0.1:4173/quotations/add",
        "http://127.0.0.1:4173/purchase-orders",
        "http://127.0.0.1:4173/invoices"
      ],
      "numberOfRuns": 3,
      "puppeteerScript": "./lighthouse/login-fixture.cjs",
      "puppeteerLaunchOptions": {
        "args": ["--no-sandbox", "--disable-setuid-sandbox"]
      },
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --disable-setuid-sandbox",
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo"],
        "skipAudits": ["uses-http2", "is-crawlable", "canonical"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
