GH_OWNER=your-github-username
TAG=latest

DB_NAME=gns_quotation
DB_USER=gns_app
DB_PASSWORD=change_me_strong_password

JWT_SECRET=generate_with_openssl_rand_hex_32

CORS_ALLOWED_ORIGINS=https://internalgns.yourdomain.id

SUPERADMIN_EMAIL=admin@globalsakti.com
SUPERADMIN_NAME=Administrator
SUPERADMIN_PASSWORD=CHANGE_ME_before_deploy

# Optional second superadmin (skipped if EMAIL or PASSWORD is empty).
SUPERADMIN2_EMAIL=
SUPERADMIN2_NAME=Administrator 2
SUPERADMIN2_PASSWORD=

MINIO_USER=minioadmin
MINIO_PASSWORD=change_me_strong_password

# Public S3 host for presigned upload/download URLs (browser-reachable).
# Point a DNS A record at the VPS; Traefik issues the cert automatically.
MINIO_HOST=s3.internalgns.yourdomain.id
# Web app origin allowed to PUT presigned URLs cross-origin (no trailing slash).
WEB_ORIGIN=https://internalgns.yourdomain.id

# Coretax (DJP) e-faktur XML export. 16-digit NPWP (no separators);
# IDTKU = NPWP + 6-digit branch suffix (`000000` for headquarters).
CORETAX_SELLER_TIN=
CORETAX_SELLER_IDTKU=

API_HOST=api.internalgns.yourdomain.id
WEB_HOST=internalgns.yourdomain.id

# Baked into FE bundle at image build time. CI must pass it as build arg.
VITE_API_URL=https://api.internalgns.yourdomain.id/api/v1
